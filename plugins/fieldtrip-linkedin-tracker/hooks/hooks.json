{
  "description": "Read-only guard for the LinkedIn MCP: blocks every LinkedIn tool except the inbox/profile read tools.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*linkedin.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/linkedin_guard.py\""
          }
        ]
      }
    ]
  }
}
